{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },

  "JWT": {
    "Key": "",
    "Issuer": "Homiee",
    "Audience": "HomieeUser",
    "ExpiresAt": 60
  },

  "Gemini": {
    "ApiKey": "",
    "ModelName": "gemini-2.5-flash-image",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "TimeoutSeconds": 60,
    "SampleCount": 1
  },

  "AiImage": {
    "GenerationCacheTtlMinutes": 60,
    "RateLimitMaxRequests": 5,
    "RateLimitWindowMinutes": 60,
    "CooldownSeconds": 10,
    "MaxPromptLength": 500,
    "MinPromptLength": 5,
    "MaxJobRetries": 2,
    "ResultRetentionHours": 24
  },

  "CacheSettings": {
    "CategoryTtlMinutes": 30,
    "ProductDetailTtlMinutes": 10,
    "SellerDetailTtlMinutes": 15,
    "StoreTtlMinutes": 5,
    "AdminAnalyticsTtlMinutes": 5,
    "AdminKpiTtlMinutes": 2,
    "SellerAnalyticsTtlMinutes": 5,
    "SellerKpiTtlMinutes": 2,
    "RecommendationTtlMinutes": 10,
    "CartTtlMinutes": 5,
    "WishlistTtlMinutes": 10,
    "RevokedTokenTtlMinutes": 15
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": ""
  },

  "AzureBlob": {
    "ConnectionString": "",
    "ContainerName": "homieeimages"
  },

  "RecommendationWeights": {
    "CategoryMatch": 40.0,
    "PriceSimilarity": 25.0,
    "SameSeller": 15.0,
    "Rating": 10.0,
    "ReviewCount": 10.0
  },

  "Razorpay": {
    "Key": "",
    "Secret": "",
    "WebhookSecret": ""
  },

  "AllowedOrigins": [
    "https://homiee.suhailaslam.in",
    "http://127.0.0.1:5173"
  ],
  "Sentry": {
  "Dsn": ""
},

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/serilog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },

  "AllowedHosts": "*"
